#!/bin/sh
# なでしこ版DocTestを、配置したgonakoで起動する。
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root_dir=$(dirname -- "$script_dir")
runtime=${GONAKO_RUNTIME:-}
if [ -z "$runtime" ]; then
    if [ -x "$script_dir/gonako" ]; then
        runtime=$script_dir/gonako
    else
        runtime=$(command -v gonako)
    fi
fi
export GONAKO_DOCTEST_RUNTIME="$runtime"
exec "$runtime" "$root_dir/gonako-package/doctest/index.nako3" "$@"
