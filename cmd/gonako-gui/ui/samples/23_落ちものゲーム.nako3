### ブロックを落としてラインをそろえる落ちものゲーム
### tags = GUI,ゲーム
### mode = newwindow
// 落ちものゲーム (テトリス風)
// キャンバスを一度クリックしてフォーカスを当て、矢印キーでブロックを動かします。
// ←→: 移動、↓: 早落とし、↑: 回転。横一列がそろうとラインが消えて得点が増えます。
// ブロックの形は [x, y] のオフセットの配列で持ち、回転は座標変換で計算します。
// キー入力は『キー押下時』イベント、落下は『秒毎』タイマーを使います。

横マス = 10
縦マス = 20
セル = 22
絵 = [横マス * セル, 縦マス * セル]のキャンバス作成
絵に{"border": "1px solid gray"}をDOMスタイル一括設定
改行作成
状態ラベル = 「キャンバスをクリックして、矢印キーで操作してください」のラベル作成

// ブロックの形 (7種)。[x, y] オフセットの集まりで表す
形一覧 = []
形一覧に[[0, 0], [1, 0], [2, 0], [3, 0]]を配列追加
形一覧に[[0, 0], [1, 0], [0, 1], [1, 1]]を配列追加
形一覧に[[0, 0], [1, 0], [2, 0], [1, 1]]を配列追加
形一覧に[[1, 0], [2, 0], [0, 1], [1, 1]]を配列追加
形一覧に[[0, 0], [1, 0], [1, 1], [2, 1]]を配列追加
形一覧に[[0, 0], [0, 1], [1, 1], [2, 1]]を配列追加
形一覧に[[2, 0], [0, 1], [1, 1], [2, 1]]を配列追加
色一覧 = ["cyan", "yellow", "purple", "limegreen", "red", "blue", "orange"]

// 盤 (0=空き、1〜7=色番号)
盤 = []
Y = 0
Y < 縦マス の間
　行 = []
　X = 0
　X < 横マス の間
　　行に0を配列追加
　　X = X + 1
　ここまで
　盤に行を配列追加
　Y = Y + 1
ここまで

得点 = 0
終了フラグ = オフ
衝突 = オフ
現在形 = []
現在色 = 「」
現在番号 = 0
現在X = 3
現在Y = 0

// 形を (PX, PY) に置けるかどうかを調べ、結果を『衝突』に入れる
●衝突判定 (形, PX, PY) とは
　衝突 = オフ
　形を反復
　　位置 = 対象
　　X = PX + 位置[0]
　　Y = PY + 位置[1]
　　もし、X < 0 または X >= 横マス または Y >= 縦マス ならば
　　　衝突 = オン
　　ここまで
　　もし、衝突 = オフ かつ Y >= 0 ならば
　　　行 = 盤[Y]
　　　もし、行[X] > 0 ならば
　　　　衝突 = オン
　　　ここまで
　　ここまで
　ここまで
ここまで

●固定とは
　現在形を反復
　　X = 現在X + 対象[0]
　　Y = 現在Y + 対象[1]
　　行 = 盤[Y]
　　行[X] = 現在番号
　　盤[Y] = 行
　ここまで
ここまで

●ライン消去とは
　新盤 = []
　消去数 = 0
　Y = 0
　Y < 縦マス の間
　　行 = 盤[Y]
　　埋数 = 0
　　行を反復
　　　もし、対象 > 0 ならば
　　　　埋数 = 埋数 + 1
　　　ここまで
　　ここまで
　　もし、埋数 = 横マス ならば
　　　消去数 = 消去数 + 1
　　違えば
　　　新盤に行を配列追加
　　ここまで
　　Y = Y + 1
　ここまで
　行数 = 新盤の要素数
　不足 = 縦マス - 行数
　I = 0
　I < 不足 の間
　　空行 = []
　　X = 0
　　X < 横マス の間
　　　空行に0を配列追加
　　　X = X + 1
　　ここまで
　　新盤の0に空行を配列挿入
　　I = I + 1
　ここまで
　盤 = 新盤
　もし、消去数 > 0 ならば
　　得点 = 得点 + 消去数 * 100
　　状態ラベルに「得点: {得点}」をテキスト設定
　ここまで
ここまで

●ゲームオーバーとは
　終了フラグ = オン
　全タイマー停止
　状態ラベルに「ゲームオーバー！ 得点: {得点}」をテキスト設定
ここまで

●新しいブロックとは
　番号 = (7の乱数)
　元形 = 形一覧[番号]
　現在形 = []
　元形を反復
　　現在形に[対象[0], 対象[1]]を配列追加
　ここまで
　現在番号 = 番号 + 1
　現在色 = 色一覧[番号]
　現在X = 3
　現在Y = 0
　衝突判定(現在形, 現在X, 現在Y)
　もし、衝突 ならば
　　ゲームオーバー
　ここまで
ここまで

// 回転は [x, y] -> [最大Y - y, x] の座標変換で計算する (外接枠の中で回す)
●回転とは
　最大Y = 0
　現在形を反復
　　もし、対象[1] > 最大Y ならば
　　　最大Y = 対象[1]
　　ここまで
　ここまで
　回転形 = []
　現在形を反復
　　回転形に[最大Y - 対象[1], 対象[0]]を配列追加
　ここまで
　候補X一覧 = [現在X, 現在X - 1, 現在X + 1]
　適用 = 0
　I = 0
　I < 3 の間
　　もし、適用 = 0 ならば
　　　候補X = 候補X一覧[I]
　　　衝突判定(回転形, 候補X, 現在Y)
　　　もし、衝突 = オフ ならば
　　　　現在形 = 回転形
　　　　現在X = 候補X
　　　　適用 = 1
　　　ここまで
　　ここまで
　　I = I + 1
　ここまで
ここまで

●描画とは
　絵をキャンバス消去
　絵に「white」をキャンバス塗色設定
　絵の[0, 0, 横マス * セル, 縦マス * セル]へキャンバス矩形描画
　Y = 0
　Y < 縦マス の間
　　行 = 盤[Y]
　　X = 0
　　X < 横マス の間
　　　もし、行[X] > 0 ならば
　　　　絵に色一覧[行[X] - 1]をキャンバス塗色設定
　　　　絵の[X * セル + 1, Y * セル + 1, セル - 2, セル - 2]へキャンバス矩形描画
　　　ここまで
　　　X = X + 1
　　ここまで
　　Y = Y + 1
　ここまで
　もし、終了フラグ = オフ ならば
　　絵に現在色をキャンバス塗色設定
　　現在形を反復
　　　絵の[(現在X + 対象[0]) * セル + 1, (現在Y + 対象[1]) * セル + 1, セル - 2, セル - 2]へキャンバス矩形描画
　　ここまで
　ここまで
ここまで

// タイマーに渡す処理は、変数に入れた関数の形で定義します
落下処理 = 関数()
　もし、終了フラグ ならば、戻る。
　衝突判定(現在形, 現在X, 現在Y + 1)
　もし、衝突 ならば
　　固定
　　ライン消去
　　新しいブロック
　違えば
　　現在Y = 現在Y + 1
　ここまで
　描画
ここまで

絵をキー押下した時には
　もし、終了フラグ = オフ ならば
　　もし、押下キー = 「ArrowLeft」 ならば
　　　衝突判定(現在形, 現在X - 1, 現在Y)
　　　もし、衝突 = オフ ならば
　　　　現在X = 現在X - 1
　　　　描画
　　　ここまで
　　ここまで
　　もし、押下キー = 「ArrowRight」 ならば
　　　衝突判定(現在形, 現在X + 1, 現在Y)
　　　もし、衝突 = オフ ならば
　　　　現在X = 現在X + 1
　　　　描画
　　　ここまで
　　ここまで
　　もし、押下キー = 「ArrowUp」 ならば
　　　回転
　　　描画
　　ここまで
　　もし、押下キー = 「ArrowDown」 ならば
　　　衝突判定(現在形, 現在X, 現在Y + 1)
　　　もし、衝突 = オフ ならば
　　　　現在Y = 現在Y + 1
　　　　描画
　　　ここまで
　　ここまで
　ここまで
ここまで

新しいブロック
描画
落下処理を0.5秒毎
