# マンデルブロ集合の反復計算
●マンデルブロ計算とは
  W = 150
  H = 150
  最大回数 = 100
  合計回数 = 0
  ループY = 0
  (ループY < H)の間
    Cy = (0 - 1.2) + ((ループY / H) * 2.4)
    ループX = 0
    (ループX < W)の間
      Cx = (0 - 2.0) + ((ループX / W) * 2.5)
      Zx = 0.0
      Zy = 0.0
      回数 = 0
      (回数 < 最大回数)の間
        ZZ = (Zx * Zx) + (Zy * Zy)
        もし、ZZ > 4.0ならば
          抜ける
        ここまで
        次X = ((Zx * Zx) - (Zy * Zy)) + Cx
        次Y = ((2.0 * Zx) * Zy) + Cy
        Zx = 次X
        Zy = 次Y
        回数 = 回数 + 1
      ここまで
      合計回数 = 合計回数 + 回数
      ループX = ループX + 1
    ここまで
    ループY = ループY + 1
  ここまで
  合計回数を戻す
ここまで

結果 = マンデルブロ計算
「mandelbrot(150x150) = {結果}」を表示
