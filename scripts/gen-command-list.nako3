### 定数・システム変数を命令一覧 (command-list.json) へ反映するバッチ (#474)
### tags = 仕事自動化,CUI
### mode = cli
#
# 使い方: リポジトリのルートで `gonako run scripts/gen-command-list.nako3`
#
# 役割: 既存の command-list.json (本家TSの説明でキュレーションされた関数一覧) を土台に、
# Goソースから定数・システム変数 (type が const/var の項目) だけを抽出して差し替え・追加し、
# internal/commanddoc/command-list.json と cmd/gonako-gui/ui/command-list.json へ書き出す。
# 関数一覧の全体再生成は Go 版の scripts/gen-command-list.go (本家 clone が必要) の担当で、
# このバッチは定数・変数の増分マージだけを行うので、本家 clone が無い環境でも
# 既存の関数の説明文・分類を壊さない。
#
# 定数の説明文は、Go側の定義行の末尾コメント `// @説明 // @よみ` から取る。
# 抽出パターン (優先度の高い順):
#   4: addConst("名前", ...)              internal/stdlib/registry.go
#   3: list["名前"] = ... Type: "const"/"var"  (同じ行から次の2行以内を見る)
#   2: "名前": { ..., Type: "const", ... }     officelib/sqlitelib のマップリテラル
#   1: internal/nodelib/file.go の constants() のマップ項目

# --- 小物関数 ---

●(文字列と検索文字列で)部分一致とは
  部品 = 文字列を検索文字列で区切る
  個数 = 部品の要素数
  もし、(個数 > 1)ならば
    真を戻す
  ここまで
  偽を戻す
ここまで

●(文字列と接頭辞で)引用名取得とは
  部品 = 文字列を接頭辞で区切る
  個数 = 部品の要素数
  もし、(個数 < 2)ならば
    空を戻す
  ここまで
  残り = 部品[1]
  部品 = 残りを「"」で区切る
  部品[0]を戻す
ここまで

●(行と名前と種類で)説明ヨミ取得とは
  結果 = {}
  部品 = 行を「// @」で区切る
  個数 = 部品の要素数
  もし、(個数 < 2)ならば
    もし、(種類 = 「const」)ならば
      結果["desc"] = 「定数『{名前}』です」
    違えば
      結果["desc"] = 「システム変数『{名前}』です」
    ここまで
    結果["yomi"] = 空
    結果を戻す
  ここまで
  説明 = 部品[1]を右トリム
  ヨミ = 空
  もし、(個数 > 2)ならば
    ヨミ = 部品[2]を右トリム
  ここまで
  結果["desc"] = 説明
  結果["yomi"] = ヨミ
  結果を戻す
ここまで

●(ファイルと種類で)分類取得とは
  結果 = {}
  結果["docPlugin"] = 「gonako」
  stdlib判定 = ファイルと「internal/stdlib/」で部分一致
  nodelib判定 = ファイルと「internal/nodelib/」で部分一致
  guilib判定 = ファイルと「internal/guilib/」で部分一致
  officelib判定 = ファイルと「internal/officelib/」で部分一致
  sqlitelib判定 = ファイルと「internal/sqlitelib/」で部分一致
  # 違えば、(条件)ならば の連鎖は使わず、先に決まった分類を確定フラグで守る。
  確定 = 偽
  もし、(stdlib判定 = 真)ならば
    結果["plugin"] = 「plugin_system」
    結果["docPlugin"] = 「plugin_system」
    もし、(種類 = 「var」)ならば
      結果["category"] = 「システム変数」
    違えば
      結果["category"] = 「システム定数」
    ここまで
    確定 = 真
  ここまで
  もし、(確定 = 偽)ならば
    もし、(nodelib判定 = 真)ならば
      結果["plugin"] = 「plugin_node」
      もし、(種類 = 「var」)ならば
        結果["category"] = 「システム変数」
      違えば
        結果["category"] = 「システム定数」
      ここまで
      確定 = 真
    ここまで
  ここまで
  もし、(確定 = 偽)ならば
    もし、(guilib判定 = 真)ならば
      結果["plugin"] = 「gonako」
      結果["category"] = 「GUI」
      確定 = 真
    ここまで
  ここまで
  もし、(確定 = 偽)ならば
    もし、(officelib判定 = 真)ならば
      結果["plugin"] = 「gonako」
      結果["category"] = 「Excel」
      確定 = 真
    ここまで
  ここまで
  もし、(確定 = 偽)ならば
    もし、(sqlitelib判定 = 真)ならば
      結果["plugin"] = 「gonako」
      結果["category"] = 「SQLite」
      確定 = 真
    ここまで
  ここまで
  もし、(確定 = 偽)ならば
    結果["plugin"] = 「gonako」
    結果["category"] = 「システム定数」
  ここまで
  結果を戻す
ここまで

# 注意: gonako の関数内からはグローバル変数を読み書きできない (引数で渡した
# 配列・辞書は参照として書き換えられる)。そのため登録先の辞書と、処理中の
# ファイル・行番号・行は、すべて引数で渡す。
●(抽出辞書と登録優先度とファイルと行番号と行と名前と種類と優先度で)定数登録とは
  既存優先度 = 登録優先度[名前]
  もし、(既存優先度 <> 未定義)ならば
    もし、(既存優先度 >= 優先度)ならば
      戻る
    ここまで
  ここまで
  コメント = 行と名前と種類で説明ヨミ取得
  分類 = ファイルと種類で分類取得
  項目 = {}
  # この順に代入して、JSONのキー順を Go 版の生成結果と揃える。
  項目["name"] = 名前
  項目["type"] = 種類
  項目["josi"] = NULL
  項目["plugin"] = 分類["plugin"]
  項目["category"] = 分類["category"]
  項目["desc"] = コメント["desc"]
  項目["template"] = 名前
  ヨミ = コメント["yomi"]
  もし、(ヨミ <> 空)ならば
    項目["yomi"] = ヨミ
  ここまで
  項目["file"] = ファイル
  項目["line"] = 行番号
  行番号文字列 = 行番号を文字列変換
  項目["url"] = 「https://github.com/kujirahand/nadesiko3go/blob/master/」＆ファイル＆「#L」＆行番号文字列
  文書キー = 分類["docPlugin"]＆「/」＆名前
  項目["docUrl"] = 「https://nadesi.com/v3/doc/index.php?」＆(文書キーをURLエンコード)
  抽出辞書[名前] = 項目
  登録優先度[名前] = 優先度
ここまで

●(AとBで)名前比較とは
  もし、(A["name"] < B["name"])ならば
    -1を戻す
  ここまで
  もし、(A["name"] > B["name"])ならば
    1を戻す
  ここまで
  0を戻す
ここまで

# --- 抽出 ---

抽出辞書 = {}
登録優先度 = {}
現在行番号 = 0

対象ファイル一覧 = 「internal」の全ファイル列挙
ファイル数 = 対象ファイル一覧の要素数
F = 0
(F < ファイル数)の間
  ファイル = 対象ファイル一覧[F]
  F = F + 1
  Goファイル判定 = ファイルが「.go」で文字終
  もし、(Goファイル判定 = 偽)ならば
    続ける
  ここまで
  テストファイル判定 = ファイルが「_test.go」で文字終
  もし、(テストファイル判定 = 真)ならば
    続ける
  ここまで
  本文 = ファイルを開く
  本文 = 本文のCRを「」に置換
  行一覧 = 本文を改行で区切る
  行数 = 行一覧の要素数
  constants内 = 偽
  I = 0
  (I < 行数)の間
    現在行番号 = I + 1
    行 = 行一覧[I]
    # コメントアウトされた旧定義などを拾わないよう、// で始まる行は対象外にする。
    左詰行 = 行を左トリム
    コメント部品 = 左詰行を「//」で区切る
    もし、(コメント部品[0] = 空)ならば
      I = I + 1
      続ける
    ここまで
    空白除去行 = 行の「 」を「」に置換
    空白除去行 = 空白除去行のタブを「」に置換

    # パターン1 (優先度1): nodelib/file.go の constants() のマップ項目
    もし、(ファイル = 「internal/nodelib/file.go」)ならば
      関数開始判定 = 空白除去行と「funcconstants()」で部分一致
      もし、(関数開始判定 = 真)ならば
        constants内 = 真
      ここまで
      もし、(constants内 = 真)ならば
        部品 = 空白除去行を「"」で区切る
        部品数 = 部品の要素数
        もし、(部品数 >= 3)ならば
          もし、(部品[0] = 空)ならば
            # 値が文字列リテラルでない項目 (パス区切など) は部品[2] が「:値...」になるので、
            # コロンで始まることだけを確認する。
            コロン部品 = 部品[2]を「:」で区切る
            もし、(コロン部品[0] = 空)ならば
              名前候補 = 部品[1]
              もし、(名前候補 <> 空)ならば
                抽出辞書と登録優先度とファイルと現在行番号と行と名前候補と「const」と1で定数登録
              ここまで
            ここまで
          ここまで
        ここまで
      ここまで
      もし、(空白除去行 = 「}」)ならば
        constants内 = 偽
      ここまで
    ここまで

    # パターンa (優先度4): addConst("名前", ...)
    addConst判定 = 行と「addConst("」で部分一致
    もし、(addConst判定 = 真)ならば
      名前候補 = 行と「addConst("」で引用名取得
      もし、(名前候補 <> 空)ならば
        抽出辞書と登録優先度とファイルと現在行番号と行と名前候補と「const」と4で定数登録
      ここまで
    ここまで

    # パターンb (優先度3): list["名前"] = ... の Type を同じ行から次の2行で見る
    list判定 = 行と「list["」で部分一致
    代入判定 = 行と「"] =」で部分一致
    もし、(list判定 = 真)ならば
      もし、(代入判定 = 真)ならば
        名前候補 = 行と「list["」で引用名取得
        種類候補 = 空
        J = 0
        (J < 3)の間
          候補番号 = I + J
          J = J + 1
          もし、(候補番号 < 行数)ならば
            候補行 = 行一覧[候補番号]
            # 次の list[...] 代入が始まったら、種別の探索はそこで打ち切る
            # (隣の定義の Type を誤って関連付けないため)。
            次定義判定 = 候補行と「list["」で部分一致
            もし、(候補番号 > I)ならば
              もし、(次定義判定 = 真)ならば
                J = 99
              ここまで
            ここまで
            もし、(J < 99)ならば
              もし、(種類候補 = 空)ならば
                const種別判定 = 候補行と「Type: "const"」で部分一致
                var種別判定 = 候補行と「Type: "var"」で部分一致
                もし、(const種別判定 = 真)ならば
                  種類候補 = 「const」
                違えば
                  もし、(var種別判定 = 真)ならば
                    種類候補 = 「var」
                  ここまで
                ここまで
              ここまで
            ここまで
          ここまで
        ここまで
        もし、(名前候補 <> 空)ならば
          もし、(種類候補 <> 空)ならば
            抽出辞書と登録優先度とファイルと現在行番号と行と名前候補と種類候補と3で定数登録
          ここまで
        ここまで
      ここまで
    ここまで

    # パターンc (優先度2): "名前": { ..., Type: "const", ... } のマップリテラル
    波括弧判定 = 空白除去行と(「":」＆(123のCHR))で部分一致
    const種別判定2 = 行と「Type: "const"」で部分一致
    もし、(波括弧判定 = 真)ならば
      もし、(const種別判定2 = 真)ならば
        部品 = 空白除去行を「"」で区切る
        部品数 = 部品の要素数
        もし、(部品数 >= 2)ならば
          もし、(部品[0] = 空)ならば
            名前候補 = 部品[1]
            もし、(名前候補 <> 空)ならば
              抽出辞書と登録優先度とファイルと現在行番号と行と名前候補と「const」と2で定数登録
            ここまで
          ここまで
        ここまで
      ここまで
    ここまで

    I = I + 1
  ここまで
ここまで

# --- 既存一覧とマージ ---

既存一覧 = 「internal/commanddoc/command-list.json」を開く
既存一覧 = 既存一覧をJSONデコード
出力一覧 = []
既存数 = 既存一覧の要素数
K = 0
(K < 既存数)の間
  項目 = 既存一覧[K]
  K = K + 1
  名前 = 項目["name"]
  もし、(抽出辞書[名前] = 未定義)ならば
    出力一覧に項目を配列追加
  ここまで
ここまで

定数数 = 0
変数数 = 0
抽出名一覧 = 抽出辞書の辞書キー列挙
抽出数 = 抽出名一覧の要素数
K = 0
(K < 抽出数)の間
  名前 = 抽出名一覧[K]
  K = K + 1
  項目 = 抽出辞書[名前]
  出力一覧に項目を配列追加
  もし、(項目["type"] = 「const」)ならば
    定数数 = 定数数 + 1
  違えば
    変数数 = 変数数 + 1
  ここまで
ここまで

出力一覧 = 出力一覧を「名前比較」で配列カスタムソート
JSON = 出力一覧をJSONエンコード整形

# Go版 (encoding/json) の書式に合わせて、HTMLエスケープ相当の置換を行う。
# JSONの構造文字に & < > は現れないため、全体置換で安全 (& を最初に置換する)。
バックスラッシュ = 「\」
JSON = JSONの「&」を(バックスラッシュ＆「u0026」)に置換
JSON = JSONの「<」を(バックスラッシュ＆「u003c」)に置換
JSON = JSONの「>」を(バックスラッシュ＆「u003e」)に置換

JSONを「internal/commanddoc/command-list.json」に保存
JSONを「cmd/gonako-gui/ui/command-list.json」に保存

全件数 = 出力一覧の要素数
「定数{定数数}件・変数{変数数}件を反映し、全{全件数}件を書き出しました」を表示
